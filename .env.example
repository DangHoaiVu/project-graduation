# ==========================================
# Database (Supabase PostgreSQL & Drizzle ORM)
# ==========================================
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# Storage (Cloudinary)
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# ==========================================
# AI Providers & External Integrations
# ==========================================
# Gemini: https://aistudio.google.com/apikey
# Single key or Key Pool (comma/newline separated for multiple accounts, e.g. 4 keys = 60 RPM):
GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_API_KEYS="key1,key2,key3,key4"
# Groq: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."
# Cohere (RAG Mũi nhọn): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""

# AI Horde (Lưới bảo hiểm vô cực): https://aihorde.net/register (Mặc định 0000000000 dùng ẩn danh miễn phí)
AI_HORDE_API_KEY="0000000000"

# Anthropic: https://console.anthropic.com/settings/keys
MOODLE_URL="https://your-moodle-site.edu.vn"
MOODLE_TOKEN="your-moodle-rest-token"
MOODLE_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# ==========================================
# Firebase & Cloud Messaging (Push Notifications)
# ==========================================
# Firebase Web Config (Firebase Console -> Project Settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef..."
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
# Web Push Certificate / VAPID Key (Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY="B..."

# Firebase Admin SDK (Server-side sending: Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_PROJECT_ID="your-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

